# Copy this file to .env and edit it. .env is git-ignored: never commit real secrets.
# The application reads it from the project root (the same folder as this file).

# --- Core -------------------------------------------------------------------------------------------------------
ENVIRONMENT=development                # development | production
# REQUIRED in production. Generate one with:  python -c "import secrets; print(secrets.token_urlsafe(48))"
# In development an unset or placeholder value gets a random key at every start, so sessions end on restart.
SECRET_KEY=change-me-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=60

# --- Database ---------------------------------------------------------------------------------------------------
# Default (no setting needed): SQLite file at storage/app.db. For PostgreSQL:
# DATABASE_URL=postgresql+psycopg://dfnd:change-this-password@localhost:5432/dfnd
# With PostgreSQL or Docker, run "python -m app.db.migrate" (from backend/) and set AUTO_CREATE_TABLES=false.
AUTO_CREATE_TABLES=true

# --- Browser access ---------------------------------------------------------------------------------------------
# Origins allowed to call the API directly. The dev server and Docker setup proxy /api, so this rarely matters.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- First administrator (optional) -----------------------------------------------------------------------------
# Created at start-up when both are set and no user with that e-mail exists. Remove the password afterwards.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# --- Limits -----------------------------------------------------------------------------------------------------
MAX_IMAGE_MB=10
MAX_IMAGE_PIXELS=40000000
RATE_LIMIT_PER_MINUTE=120
AUTH_RATE_LIMIT_PER_MINUTE=10

# --- Text model decision rule (see docs/technical_documentation) ----------------------------------------------------
TEXT_CONFIDENCE_THRESHOLD=0.80
MIN_TEXT_TOKENS=60

# --- Password handling ------------------------------------------------------------------------------------------
BCRYPT_ROUNDS=12
# There is no e-mail service. true makes /auth/forgot-password return the reset token in its response so the flow can be
# tried locally. NEVER enable in production.
EXPOSE_RESET_TOKEN=false

# --- Optional features -------------------------------------------------------------------------------------------
# No key is required. Everything below has a working default.
# News web addresses: the server downloads the page itself (public websites only, with size, time and redirect limits).
URL_FETCH_ENABLED=true
URL_FETCH_RATE_LIMIT_PER_MINUTE=10
# Evidence checking searches Wikipedia. Published fact-checks (ClaimReview) are added when a Google Fact Check Tools API
# key is set; without it that source reports "not configured" and nothing is invented.
EVIDENCE_ENABLED=true
GOOGLE_FACT_CHECK_API_KEY=
# Compare an article's headline with recent headlines of well-known news organisations (Google News RSS, an unofficial feed).
# Only the headline is sent. Set to false to keep everything on this server.
CORROBORATION_ENABLED=true
# Compare the text of an article with its own headline (runs on this server and sends nothing out). Set to false to switch it off.
TEXT_MATCH_ENABLED=true
# false (default): only a text that is about another story stops a "Likely Real"; other differences between text and headline are a warning.
TEXT_MATCH_STRICT=false
# Models downloaded from the Hugging Face Hub on first use (needs backend/requirements-ml.txt).
NLI_MODEL_ID=cross-encoder/nli-deberta-v3-small
CLIP_MODEL_ID=openai/clip-vit-base-patch32
VIDEO_MODEL_ID=hchcsuim/FFPP-Raw_1FPS_faces-expand-40-aligned_val-ds-celeb-df
# Video limits. 16 sampled frames is the number the decision thresholds were measured with.
MAX_VIDEO_MB=100
MAX_VIDEO_SECONDS=180
VIDEO_SAMPLE_FRAMES=16

# --- Docker Compose only ----------------------------------------------------------------------------------------
POSTGRES_USER=dfnd
POSTGRES_PASSWORD=change-this-password
POSTGRES_DB=dfnd
WEB_PORT=8080

# --- Docker build option -----------------------------------------------------------------------------------------
# true installs torch, transformers and OpenCV into the backend image (about 2 GB), which the evidence, image-text and
# video modules need. Read by docker compose at build time, not by the application.
INSTALL_ML=false
